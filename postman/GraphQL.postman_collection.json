							"graphql": {
								"query": "mutation CreateProduct($input: ProductInput!) {\n  createProduct( input: $input) {\n    product {\n      id\n      name\n      description\n      price\n    }\n  }\n}",
								"variables": "{\n  \"input\": {\n    \"name\": \"Laptop\",\n    \"description\": \"Updated description\",\n    \"price\": \"10.99\",\n    \"categoryId\": 1\n  }\n}"
							}
