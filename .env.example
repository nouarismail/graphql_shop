# Copy this file to .env before using the stack outside local evaluation.
DJANGO_SECRET_KEY='7f4c9a2e8b1d6f03c5a7e9b2d4f6a8c1e3b5d7f9a1c3e5b7d9f2a4c6e8b0d2f4'
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

DB_NAME=shop_db
DB_USER=shop_user
DB_PASSWORD=replace-this-database-password

WEB_PORT=8000
RUN_MIGRATIONS=true
SETUP_ROLES=true

# Pending orders older than 30 minutes are scanned once per minute.
ORDER_PENDING_TIMEOUT_SECONDS=1800
ORDER_CANCELLATION_SCAN_SECONDS=60
CELERY_WORKER_CONCURRENCY=2

# Order creation is limited independently by client IP and authenticated user.
ORDER_RATE_LIMIT_REQUESTS=3
ORDER_RATE_LIMIT_WINDOW_SECONDS=3600
ORDER_RATE_LIMIT_TRUST_PROXY=true
